# ---------------------------------------------------------------------------
# Neon (Branch `production` im Projekt broad-thunder-03529066)
#
# `neon deploy` schreibt die Neon-Variablen unten automatisch in `.env.local`
# (bzw. `.env`, falls vorhanden) – hier stehen sie nur zur Orientierung.
# ---------------------------------------------------------------------------

# Neon Postgres (Lakebase) – gepoolte URL für die App, direkte für Migrationen.
# Auf Render optional: Sobald DATABASE_URL gesetzt ist, nutzt die App diese
# Datenbank (Neon wird am Hostnamen erkannt). Ohne sie greift dort die per
# render.yaml automatisch provisionierte Datenbank (AUTO_DATABASE_URL, wird
# von Render befüllt – nie von Hand setzen) und lokal die eingebettete
# PGlite-Datenbank. Ein `channel_binding=require` im Neon-String ist ok,
# die App entfernt den Parameter selbst.
DATABASE_URL=""
DATABASE_URL_UNPOOLED=""
# AUTO_DATABASE_URL=""   # nur von Render (Blueprint) befüllt, nicht eintragen
NEON_BRANCH="production"

# Neon Auth (Managed Better Auth)
NEON_AUTH_BASE_URL=""
NEON_AUTH_JWKS_URL=""
# App-Konfiguration – wird NICHT von Neon injiziert:
#   echo "NEON_AUTH_COOKIE_SECRET=$(openssl rand -base64 32)" >> .env.local
NEON_AUTH_COOKIE_SECRET=""

# Neon Object Storage (S3-kompatibel, Bucket aus neon.ts: `assets`)
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
AWS_ENDPOINT_URL_S3=""
AWS_REGION=""
# Optional, falls der Bucket anders heißt als in neon.ts:
# NEON_STORAGE_BUCKET="assets"

# Neon AI Gateway
NEON_AI_GATEWAY_TOKEN=""
NEON_AI_GATEWAY_BASE_URL=""

# Neon Functions (Slug `gamemaster` aus neon.ts)
NEON_FUNCTION_GAMEMASTER_BASE_URL=""
# Optional: festes Modell statt automatischer Auswahl aus /v1/models
# (muss dann zusätzlich in neon.ts unter functions.gamemaster.env stehen)
# GAMEMASTER_MODEL=""

# ---------------------------------------------------------------------------
# RAM-Budget (wichtig auf Render-Free mit 512 MB)
# ---------------------------------------------------------------------------
# Obergrenze für den V8-Heap des Laufzeitprozesses. Wird vom `start`-Skript in
# package.json gelesen (node --max-old-space-size=…). Ohne sie richtet sich V8
# nach dem RAM des Hosts (gemessen: 1954 MB) und der Container wird hart
# gekillt, bevor V8 überhaupt aufräumt. 384 MB Heap + ~100 MB Node/Next.js
# bleiben sicher unter 512 MB.
# NODE_MAX_OLD_SPACE_MB="384"

# Die eingebettete PGlite-Datenbank läuft als WASM-PostgreSQL IM Node-Prozess
# und kostet gemessen ~456 MB (Server gesamt: 596 MB ohne Last, 758 MB Spitze
# mit 6 pollenden Spielern). Deshalb startet sie NICHT mehr, wenn
#   a) NODE_ENV=production ist            (also bei `next start` / auf Render) oder
#   b) der Container weniger RAM meldet als PGLITE_MIN_MEMORY_MB.
# Ohne Datenbank läuft die Seite weiter (Startseite, /api/health), nur die
# Lobby-API meldet einen klaren Fehler; die Ursache steht in
# /api/health unter `status.notice`.
#
# Notausgang für Instanzen mit mindestens 1 GB RAM (z. B. Render Starter):
# PGLITE_IN_PRODUCTION="1"
# Schwelle der automatischen RAM-Erkennung anpassen (Standard 900):
# PGLITE_MIN_MEMORY_MB="900"

# ---------------------------------------------------------------------------
# Optional – lokale Entwicklung
# ---------------------------------------------------------------------------
# Ohne DATABASE_URL startet die App mit der eingebetteten PGlite-Datenbank
# (.data/pglite), ohne Auth-Zugangsdaten läuft sie anonym weiter.
# (In `next dev` ist NODE_ENV=development – dort bleibt PGlite unverändert.)
# PGLITE_DIR=".data/pglite"
# DATABASE_SSL="true"        # true/false erzwingt bzw. deaktiviert TLS
# DATABASE_POOL_MAX="4"
# LOBBY_STALE_MS="120000"
# Wie oft /api/health die Datenbank im Hintergrund prüft (ms, Standard 60000).
# Die Route selbst antwortet immer sofort – höher stellen, wenn eine Neon-DB
# zwischendurch einschlafen soll (z. B. 600000 = 10 Minuten).
# HEALTH_CHECK_INTERVAL_MS="60000"
